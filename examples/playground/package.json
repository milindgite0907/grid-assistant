{
  "name": "fluentui-prompts-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:demo": "concurrently --kill-others --names api,web \"node --watch server/index.ts --demo\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "start:api": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test server/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1 --port 5187 --strictPort"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fluentui-contrib/react-data-grid-react-window": "file:../../vendor/fluentui-contrib-react-data-grid-react-window-1.4.2.tgz",
    "@fluentui-contrib/react-prompts": "0.0.1",
    "@fluentui/react-components": "9.70.0",
    "@fluentui/react-icons": "^2.0.249",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.15.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "6.4.3"
  }
}
